{
  "name": "raindrop-coop",
  "private": true,
  "version": "0.1.0",
  "description": "A local co-op puzzle game where players merge raindrops into puddles and vote on micro-laws that affect evaporation, flow, and flooding.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "co-op",
    "puzzle",
    "canvas",
    "vite",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}